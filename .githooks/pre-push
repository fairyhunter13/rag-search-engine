#!/usr/bin/env bash
# Pre-push gate for the knowledge/ bundle.
#
# CI runs tests/test_okf_bundle.py, but only on push to the remote -- by which point the
# change is already published. This is the same check at the moment it is made.
#
# Skip with:  git push --no-verify
#
# Install:    git config core.hooksPath .githooks
# Uninstall:  git config --unset core.hooksPath
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

if [[ -d "$REPO_ROOT/knowledge" ]]; then
  if ! command -v okfrules >/dev/null 2>&1; then
    echo "[pre-push] ✗ okfrules not installed — knowledge/ cannot be checked, and this hook is its only local gate"
    echo "[pre-push]   go install github.com/fairyhunter13/okf/cmd/okfrules@v0.6.0"
    exit 1
  fi
  # -Werror, matching the CI step: a broken link is a *warning*, which plain check prints and
  # then exits 0 on.
  if ! okfrules check -Werror "$REPO_ROOT/knowledge"; then
    echo "[pre-push] ✗ knowledge/ is not a conformant OKF bundle — push blocked"
    exit 1
  fi
fi

exit 0
